<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-BmbxuPwQa2lc/FVzBcNJ7UAyJxM6wuqIj61tLrc4wSX0szH/Ev+nYRRuWlolflfl" crossorigin="anonymous">
    <link rel="stylesheet" href="/style.css">
    <title>Identify</title>
</head>
<body>

<!--
    <nav>
        <h4> Identi </h4>
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/login">Login</a></li>
            <li><a href="/register">Register</a></li>
        </ul>

    </nav>

    -->

    <div class="entire_screen">
        
        <div class="white_container">

            <img src="../logo_identi.svg" alt ="this is our logo" id="logo_above_form"/>

            <form action="/auth/login" method="POST">

                <div class="form-group">
                    <input type="email" class="form-control" id="email" name="email" placeholder="E-mail" />
                </div>

                <div class="form-group">
                    <input type="password" class="form-control" id="password" name="password" placeholder="Lösenord" />
                </div>

                <button type="submit" class="primary_button">Logga in</button>

            </form>

            <div class="line">
                <a href="url" class="links"> Glömt lösenord? </a>
            </div>

            {{#if message}}
            <h4 class="alert alert-danger mt-4">{{message}}</h4>
            {{/if}}

        </div>

        <div class="white_container_two">

            <div class="register">
                <p class="links"> Har du inget konto? <a href="/register" class="links"> Registrera dig här </a> </p> 
            </div>

        </div>

    </div>

</body>
</html>
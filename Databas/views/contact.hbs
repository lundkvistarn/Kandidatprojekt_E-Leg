<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-BmbxuPwQa2lc/FVzBcNJ7UAyJxM6wuqIj61tLrc4wSX0szH/Ev+nYRRuWlolflfl" crossorigin="anonymous">
    <link rel="stylesheet" href="/style_profile.css">
    <link rel="icon" type="image/png" href="../img/logo_identi.svg"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">


    <title>Identify</title>
</head>
<body>

    <div class="top_bar">
        <a href="/profile"><img src="../logo_identi.svg" alt ="this is our logo" id="logo_top_bar"/></a>
        <h4 id="textLogo_top_bar">Identify </h4>
    </div>

    <nav>
        <div class="logowithtext_nav">
            <a href="/profile"><img src="../logo_identi.svg" alt ="this is our logo" id="logo_nav"/></a>
            <h4 id="textLogo"> Identify </h4>
        </div> 

        <ul>
            {{#if user}}
                <li><a id="hrefnav" href="/safetylevel"> <i class="fa fa-badge"></i> Säkerhetsnivå: {{user.safetylevel}}</a></li>
                <li><a id="hrefnav" href="/settings"> <i class="fa fa-cog"></i> Inställningar</a></li>
                <li><a id="hrefnav" href="/auth/logout"> <i class="fa fa-sign-out"></i> Logga ut</a></li>
            {{else}}
                <li><a id="hrefnav" href="/login">Login</a></li>
                <li><a id="hrefnav" href="/register">Register</a></li>
            {{/if}}
        </ul>
    </nav>

    <div class="navbar">
        <div class="hamburger">
            <div id="myLinks">
                 <a href="/safetylevel"> <i class="fa fa-"></i> Säkerhetsnivå: {{user.safetylevel}}</a>
                 <a href="/settings"> <i class="fa fa-cog"></i> Inställningar</a>
                 <a href="/auth/logout"> <i class="fa fa-sign-out"></i>  Logga ut</a>
            </div>
            <a href="javascript:void(0);" class="icon" onclick="myFunction()">
                <i class="fa fa-bars"></i>
            </a>
        </div>
    </div>

    <div class="welcome_container" id="wc_stable">
            <h4> Kontakt </h4>
    </div>
    
    <div class="entire_screen">

        <div id="ver" ss-container>
            
            <p id="brodtext"> 
                Allt gott - 

                Erik, Anders, Linnea, Moa, Ludde, Richard o Calle
            </p>
            
        </div>

        <div class="get_back"> 
            <form method="GET" action="/profile">
                <button class="button" type="submit">Tillbaka</button>
            </form>  
        </div>

        <div class="information_container">
            <div class="line">
                <hr class="style-six"> </hr>
            </div>

            <div class="information_line">
                <a href="/about_us">Om oss</a>
                <a href="/security">Säkerhet</a>
                <a href="/contact">Kontakt</a>
                <a id="loggaut_information_line" href="/auth/logout">Logga ut</a>
            </div>
        </div>
    </div>

</body>
</html>



<script>
    function myFunction() {
        var x = document.getElementById("myLinks");
        if (x.style.display === "block") {
            x.style.display = "none";
        } else {
            x.style.display = "block";
        }
    }
</script>



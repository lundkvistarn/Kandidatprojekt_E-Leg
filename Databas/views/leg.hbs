<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-BmbxuPwQa2lc/FVzBcNJ7UAyJxM6wuqIj61tLrc4wSX0szH/Ev+nYRRuWlolflfl" crossorigin="anonymous">
    <link rel="stylesheet" href="/style_profile.css">
    <link href="https://fonts.googleapis.com/css?family=Alatsi&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="../img/logo_identi.svg"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@700&display=swap" rel="stylesheet">

    <title>Identify</title>
</head>

<body>

    <div class="top_bar">
        <a href="/profile"><img src="../logo_identi.svg" alt ="this is our logo" id="logo_top_bar"/></a>
        <h4 id="textLogo_top_bar">Identify </h4>
    </div>

    <nav>
        <div class="logowithtext_nav">
            <a href="/profile"><img src="../logo_identi.svg" alt ="this is our logo" id="logo_nav"/></a>
            <h4 id="textLogo"> Identify </h4>
        </div> 
        
        <ul>
            {{#if user}}
                <li><a id="hrefnav" href="/safetylevel"> <i class="fa fa-badge"></i> Säkerhetsnivå: {{user.safetylevel}}</a></li>
                <li><a id="hrefnav" href="/settings"> <i class="fa fa-cog"></i> Inställningar</a></li>
                <li><a id="hrefnav" href="/auth/logout"> <i class="fa fa-sign-out"></i> Logga ut</a></li>
            {{else}}
                <li><a id="hrefnav" href="/login">Login</a></li>
                <li><a id="hrefnav" href="/register">Register</a></li>
            {{/if}}
        </ul>
    </nav>

    <div class="navbar">
        <div class="hamburger">
            <div id="myLinks">
                 <a href="/profile"> <i class="fa fa-reply"></i> Tillbaka </a>
                 <a href="/safetylevel"> <i class="fa fa-"></i> Säkerhetsnivå: {{user.safetylevel}} </a>
                 <a href="/settings"> <i class="fa fa-cog"></i> Inställningar</a>
                 <a href="/auth/logout"> <i class="fa fa-sign-out"></i>  Logga ut</a>
            </div>
            <a href="/profile" class="icon" onclick="">
                <i class="fa fa-reply"></i>
            </a>
        </div>
    </div>
    
    <div class="getback_container">
    </div>

    <div class="entire_screen">

        <div class="welcome_container">
            <h6 class="card-title" id="card-title_leg"> <a href="/profile">Hem</a> -> <a href="/leg" id="active_breadcrumb"> Legitimeringskort</a></h6>
        </div>
        
        <div class="button_container" id="bc_leftandright">
            
            <div class="left">

                <div>
                    <img src="../fifflaren.jpg" id="checkmark_leg" alt="checkmark">
                </div>
                
                <h3 class="accountName" id="accountName_leg"> {{user.name}} </h3> 

                <div class="row">

                    <div class="accountBox" id="accountBox_leg">

                        <div class="line" id="line_leg">
                            <hr id="ss_leg"></hr>   
                        </div>

                        <p class="accountText_leg"> <i id="iSpace_leg" class="fa fa-envelope fa-fw"> </i> {{user.email}} </p>
                        <p class="accountText_leg"> <i id="iSpace_leg" class="fa fa-map-marker fa-fw"> </i> {{user.address}} </p>
                        <p class="accountText_leg"> <i id="iSpace_leg" class="fa fa-id-card fa-fw"> </i> {{user.personid}} </p>

                    </div>

                </div>
            </div>

            <div class="vl"></div>

            <div class="line" id="line_legs">
                    <hr id="ss_leg"></hr>   
            </div>

            <div class="right">
                <canvas id="qr-code"> </canvas>
            </div>     

        </div>
        
        <div class="information_container" id="ic_leg">
            <div class="line">
                <hr class="style-six"> </hr>
            </div>

            <div class="information_line">
                <a href="/about_us">Om oss</a>
                <a href="/security">Säkerhet</a>
                <a href="/contact">Kontakt</a>
                <a id="loggaut_information_line" href="/auth/logout">Logga ut</a>
            </div>
        </div>

</div>

    <script
        src="https://cdnjs.cloudflare.com/ajax/libs/qrious/4.0.2/qrious.min.js">
    </script>

    <script>
        var qr;
        (function () {
            // TAr in var. 
            //Create QR w. qr-text
            qr = new QRious({
                element: document.getElementById('qr-code'),
                size: 200,
                value: "Richard Sven Olle Gotthard prnr: 19970810-1337"
            });
        })();
    </script>

</body>

</html>

<script>

    function myFunction() {
        var x = document.getElementById("myLinks");
        if (x.style.display === "block") {
            x.style.display = "none";
        } else {
            x.style.display = "block";
        }
    }

    function togglePopup() {
        document.getElementById("popup-1").classList.toggle("active");
    }

</script>
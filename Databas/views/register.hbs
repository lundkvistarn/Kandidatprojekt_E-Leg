<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-BmbxuPwQa2lc/FVzBcNJ7UAyJxM6wuqIj61tLrc4wSX0szH/Ev+nYRRuWlolflfl" crossorigin="anonymous">
    <link rel="stylesheet" href="/style.css">
    <title>Identify</title>
</head>
<body>

    <div class="entire_screen">

        <div class="white_container">

            <img src="../logo_identi.svg" alt ="this is our logo" id="logo_above_form"/>

                <form action="/auth/register" method="POST">
                    <!--skickar vardena till auth register - AL -->
                    <div class="form-group">
                        <input type="text" class="form-control" id="name" name="name" placeholder="För- och efternamn" />
                    </div>

                    <div class="form-group">
                        <input type="email" class="form-control" id="email" name="email" placeholder="E-mail"/>
                    </div>

                    <div class="form-group">
                        <input type="password" class="form-control" id="password" name="password" placeholder="Lösenord"/>
                    </div>

                    <div class="form-group">
                        <input type="password" class="form-control" id="passwordConfirm" name="passwordConfirm" placeholder="Bekräfta lösenord"/>
                    </div>

                    <button type="submit" class="primary_button">Registrera mig</button>
                </form>

                <div class="line">
                    <a a href="/login" class="links"> Har du redan ett konto? Logga in </a>
                </div>
        </div>

        <!--en if sats med hbs som gor alerten ifall en variabel message skickas till register - AL -->
        {{#if message}}
         <h4 class="alert alert-success mt-4">{{message}}</h4>
        {{/if}}
    </div>


</body>
</html>